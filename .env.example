# firefox-devtools-mcp environment configuration
#
# Every variable below is read by the server (src/cli.ts, src/firefox/core.ts).
# Variables marked (deprecated) or (hidden) still work but are not recommended.
# The .env file is only loaded when NODE_ENV is not "production".
# CLI flags take precedence over environment variables.

NODE_ENV=production

# Run Firefox without a UI
FIREFOX_HEADLESS=false

# Ignore self-signed and expired TLS certificates (use with caution)
ACCEPT_INSECURE_CERTS=false

# URL to open when Firefox starts
START_URL=about:blank

# Tool preset selecting which tool modules to enable (slim, basic, developer, mozilla, all)
TOOL_PRESET=basic

# Connect to an already-running Firefox (started with --marionette --remote-debugging-port)
CONNECT_EXISTING=false

# Marionette port used by CONNECT_EXISTING
MARIONETTE_PORT=2828

# Use a persistent profile stored in ~/.firefox-devtools-mcp/
AUTO_PROFILE=false

# Let saveTo write anywhere on disk (removes the default path sandbox; use with caution)
UNRESTRICTED_SAVE_PATHS=false

# Skip capturing network request/response bodies (reduces browser memory usage)
DISABLE_NETWORK_BODY_COLLECTION=false

# Firefox for Android app package (org.mozilla.firefox, org.mozilla.fenix, ...)
ANDROID_PACKAGE=org.mozilla.firefox

# Confirm that Android mode wipes all data of the target app
ANDROID_WIPE_APP_DATA=false

# Verbose logging: * or firefox-devtools
DEBUG=

# (deprecated) Selects the developer tool preset
#ENABLE_SCRIPT=false

# (deprecated) Selects the mozilla tool preset
#ENABLE_PRIVILEGED_CONTEXT=false

# (hidden) Look up the Marionette port written by Firefox's AI assistant companion
#LOOKUP_MARIONETTE_PORT=false

# MOZ_DISABLE_UPDATE_PROCESSING is set automatically by the server; do not override.

# MOZ_REMOTE_ALLOW_SYSTEM_ACCESS=1 enables privileged commands in Firefox itself.
# Consumed by Firefox (not by this server); only relevant with the -moz build.
